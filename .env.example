# Gemini API Key (Required for AI features like Smart Task Generation, Whiteboard analysis, etc.)
GEMINI_API_KEY="your-gemini-api-key-here"

# Supabase URL & Public Anon Key (Required for database, auth, and storage features)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Same Google OAuth web client configured in Supabase Auth. Server-only: used
# to refresh expired Google provider access tokens for Calendar write-through.
GOOGLE_OAUTH_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-oauth-client-secret"

# Server-only billing credentials. Never expose these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="your-supabase-secret-key-here"
STRIPE_SECRET_KEY="sk_test_or_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_YEARLY="price_..."

# Canonical deployed URL used for Checkout and Customer Portal redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Enable only after Stripe Tax is configured for the Stripe account.
STRIPE_AUTOMATIC_TAX="false"
