# Server-only Gemini key. Never expose it through NEXT_PUBLIC_* and never accept
# provider keys from end users; paid entitlement is checked before every AI call.
GEMINI_API_KEY="your-gemini-api-key-here"

# Supabase URL & Public Anon Key (Required for database, auth, and storage features)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Same Google OAuth web client configured in Supabase Auth. Server-only: used
# to refresh expired Google provider access tokens for Calendar write-through.
GOOGLE_OAUTH_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-oauth-client-secret"

# Server-only billing credentials. Never expose these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="your-supabase-secret-key-here"
PAYOS_CLIENT_ID="your-payos-client-id"
PAYOS_API_KEY="your-payos-api-key"
PAYOS_CHECKSUM_KEY="your-payos-checksum-key"

# Optional VND overrides. Omit these to use the catalog defaults in plans.ts.
# PAYOS_PRICE_STARTER_MONTHLY="199000"
# PAYOS_PRICE_STARTER_YEARLY="1790000"
# PAYOS_PRICE_PRO_MONTHLY="379000"
# PAYOS_PRICE_PRO_YEARLY="3590000"
# PAYOS_PRICE_BUSINESS_MONTHLY="699000"
# PAYOS_PRICE_BUSINESS_YEARLY="6590000"

# Optional legacy Stripe support for users who still have an active Stripe plan.
STRIPE_SECRET_KEY="sk_test_or_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Optional recurring card prices. Configure all cycles you want to sell.
# STRIPE_PRICE_STARTER_MONTHLY="price_..."
# STRIPE_PRICE_STARTER_YEARLY="price_..."
# STRIPE_PRICE_PRO_MONTHLY="price_..."
# STRIPE_PRICE_PRO_YEARLY="price_..."
# STRIPE_PRICE_BUSINESS_MONTHLY="price_..."
# STRIPE_PRICE_BUSINESS_YEARLY="price_..."

# Canonical deployed HTTPS URL used for PayOS return/cancel redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional public build metadata for self-hosting and rolling deployments.
# These values contain no secrets and are embedded at build time.
# DEPLOYMENT_VERSION="git-commit-or-release-id"

# Internal-only pricing UI route. Leave disabled in production.
# ENABLE_PRICING_PREVIEW="false"

# High-entropy salt used to pseudonymize IP addresses in immutable admin audit logs.
ADMIN_AUDIT_SALT="replace-with-at-least-32-random-characters"
ADMIN_MUTATION_LIMIT_PER_MINUTE="30"
ADMIN_REQUIRE_AAL2="true"

# Optional deployed application version shown in Apexa Control Center.
APP_VERSION="0.1.0"
