{
  "name": "apexa-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --pretty false",
    "validate:env": "node scripts/validate-env.mjs",
    "validate:production": "node scripts/validate-env.mjs --production",
    "audit:schema": "node scripts/audit-schema.mjs",
    "check": "npm run validate:env && npm run lint && npm run typecheck && npm run build",
    "payos:confirm-webhook": "node scripts/confirm-payos-webhook.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.10.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@payos/node": "2.0.5",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.112.3",
    "@tiptap/extension-collaboration": "^3.27.4",
    "@tiptap/extension-placeholder": "^3.27.4",
    "@tiptap/extension-task-item": "^3.27.4",
    "@tiptap/extension-task-list": "^3.27.4",
    "@tiptap/pm": "^3.27.4",
    "@tiptap/react": "^3.27.4",
    "@tiptap/starter-kit": "^3.27.4",
    "@tiptap/y-tiptap": "^3.0.7",
    "lucide-react": "^1.21.0",
    "motion": "^12.42.0",
    "next": "^16.3.2",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.9.0",
    "stripe": "18.5.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "@google/genai": true,
    "protobufjs": true,
    "unrs-resolver": true
